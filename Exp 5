#include <stdio.h>

#define MAX 20

int arr[MAX];
int subset[MAX];
int n, target;
int found = 0;

int results[1 << MAX][MAX];
int resultSize[1 << MAX];
int resultCount = 0;

void findSubsets(int index, int currentSum, int size) {
    int i;

    if (currentSum == target) {
        found = 1;

        for (i = 0; i < size; i++) {
            results[resultCount][i] = subset[i];
        }

        resultSize[resultCount] = size;
        resultCount++;

        return;
    }

    if (index == n || currentSum > target)
        return;

    // Include current element
    subset[size] = arr[index];
    findSubsets(index + 1, currentSum + arr[index], size + 1);

