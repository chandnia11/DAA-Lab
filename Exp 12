
#include <stdio.h>
#include <stdlib.h>

#define INF 1000000000

int n;
int cost[20][20];
int dp[1 << 20][20];

int tsp(int mask, int pos) {
    if (mask == (1 << n) - 1) {
        if (cost[pos][0] == -1)
            return INF;
        return cost[pos][0];
    }

    if (dp[mask][pos] != -1)
        return dp[mask][pos];

    int ans = INF;

    for (int city = 0; city < n; city++) {
        if (!(mask & (1 << city)) && cost[pos][city] != -1) {
            int remaining = tsp(mask | (1 << city), city);

            if (remaining != INF) {
                int total = cost[pos][city] + remaining;
                if (total < ans)
                    ans = total;
            }
        }
    }

    return dp[mask][pos] = ans;
}

int main() {
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    for (int i = 0; i < (1 << n); i++) {
        for (int j = 0; j < n; j++) {
            dp[i][j] = -1;
        }
    }

    int ans = tsp(1, 0);

    if (ans == INF)
        printf("-1\n");
    else
        printf("%d\n", ans);

    return 0;
}
